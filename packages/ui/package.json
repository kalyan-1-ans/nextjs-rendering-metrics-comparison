{
  "name": "@small-bites/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#components/*": "./src/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    "./brand/*": "./src/brand/*.tsx",
    "./typography/*": "./src/typography/*.tsx",
    "./actions/*": "./src/actions/*.tsx",
    "./forms/*": "./src/forms/*.tsx",
    "./content/*": "./src/content/*.tsx",
    "./data-display/*": "./src/data-display/*.tsx",
    "./feedback/*": "./src/feedback/*.tsx",
    "./accessibility/*": "./src/accessibility/*.tsx",
    "./layout/*": "./src/layout/*.tsx",
    "./styles.css": "./src/foundations/styles.css",
    "./fonts.css": "./src/foundations/fonts.css",
    "./assets/brand/*": "./src/assets/brand/*"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry -o storybook-static",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-serif": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.79.0",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "storybook": "10.6.8",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
