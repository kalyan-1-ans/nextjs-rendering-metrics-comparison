# Create this empty database in PostgreSQL. URL-encode special characters in credentials.
DATABASE_URL=postgresql://cms:YOUR_PASSWORD@127.0.0.1:55432/rendering_metrics_cms

# Local Docker database only. Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=YOUR_PASSWORD

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Set to the public HTTPS origin in production (no trailing slash).
CMS_URL=http://localhost:3000

# Comma-separated consumer endpoints, called after publishing site settings or home.
# Add both Vercel and Netlify deployment URLs to notify both copies of the app.
ISR_REVALIDATION_URLS=http://localhost:3001/api/revalidate
