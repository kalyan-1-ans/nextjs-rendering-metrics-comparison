{
  "name": "nextjs-rendering-metrics-comparison",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:cms": "pnpm --filter @rendering-metrics/cms dev",
    "build:cms": "pnpm --filter @rendering-metrics/cms build",
    "start:cms": "pnpm --filter @rendering-metrics/cms start",
    "typecheck:cms": "pnpm --filter @rendering-metrics/cms typecheck",
    "typecheck:cms-types": "pnpm --filter @rendering-metrics/cms-types typecheck",
    "cms:db:start": "docker compose --env-file apps/cms/.env -f apps/cms/compose.yaml up -d --wait",
    "cms:db:stop": "docker compose --env-file apps/cms/.env -f apps/cms/compose.yaml stop",
    "cms:generate:types": "pnpm --filter @rendering-metrics/cms generate:types",
    "cms:generate:importmap": "pnpm --filter @rendering-metrics/cms generate:importmap",
    "cms:migrate": "pnpm --filter @rendering-metrics/cms migrate",
    "cms:migrate:create": "pnpm --filter @rendering-metrics/cms migrate:create",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "oxlint": "1.95.0",
    "typescript": "7.0.2"
  }
}
