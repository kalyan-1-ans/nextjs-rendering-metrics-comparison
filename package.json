{
  "name": "small-bites",
  "private": true,
  "scripts": {
    "dev:isr": "pnpm --filter @small-bites/isr dev",
    "build:isr": "pnpm --filter @small-bites/isr build",
    "start:isr": "pnpm --filter @small-bites/isr start",
    "typecheck:isr": "pnpm --filter @small-bites/isr typecheck",
    "typecheck:cms-data": "pnpm --filter @small-bites/cms-data typecheck",
    "storybook": "pnpm --filter @small-bites/ui storybook",
    "build:storybook": "pnpm --filter @small-bites/ui build:storybook",
    "typecheck:ui": "pnpm --filter @small-bites/ui typecheck",
    "dev:cms": "pnpm --filter @small-bites/cms dev",
    "build:cms": "pnpm --filter @small-bites/cms build",
    "start:cms": "pnpm --filter @small-bites/cms start",
    "typecheck:cms": "pnpm --filter @small-bites/cms typecheck",
    "typecheck:cms-types": "pnpm --filter @small-bites/cms-types typecheck",
    "cms:db:start": "docker compose --env-file apps/cms/.env -f apps/cms/compose.yaml up -d --wait",
    "cms:db:stop": "docker compose --env-file apps/cms/.env -f apps/cms/compose.yaml stop",
    "cms:seed": "pnpm --filter @small-bites/cms seed",
    "cms:reset-content": "pnpm --filter @small-bites/cms reset-content",
    "cms:generate:types": "pnpm --filter @small-bites/cms generate:types",
    "cms:generate:importmap": "pnpm --filter @small-bites/cms generate:importmap",
    "cms:migrate": "pnpm --filter @small-bites/cms migrate",
    "cms:migrate:create": "pnpm --filter @small-bites/cms migrate:create",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "oxfmt": "^0.80.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.34.5"
}
